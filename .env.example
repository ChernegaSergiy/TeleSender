# Telegram API (get it at https://my.telegram.org/apps)
API_ID=YOUR_API_ID
API_HASH=YOUR_API_HASH
PHONE_NUMBER=+380XXXXXXXXX

# Users
MY_USER_ID=YOUR_TELEGRAM_ID
ALLOWED_USERS=YOUR_TELEGRAM_ID,ANOTHER_TELEGRAM_ID

# Interface language: uk, en, ru, pl, de, es, fr, pt, tr, id, it, ja, ko
LANGUAGE=en

# Web interface
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8000
# Public URL used in Telegram buttons. Empty means build it from WEB_HOST/WEB_PORT.
WEB_PUBLIC_URL=
WEB_MAX_UPLOAD_MB=200
WEB_PAGE_CACHE_TTL=15
WEB_PAGE_CACHE_SIZE=128
WEB_PAGE_CACHE_BYTES=16777216

# Cloudflared tunnel
TUNNEL_ENABLED=true
TUNNEL_PROVIDER=cloudflared
TUNNEL_REMOTE_PORT=80
TUNNEL_START_TIMEOUT=30
# Keep the tunnel process and its public URL alive across bot restarts so
# browser session cookies stay valid.
TUNNEL_KEEP_ALIVE=true

# Web interface authentication
WEB_AUTH_ENABLED=true
WEB_AUTH_PASSWORD=YOUR_WEB_PASSWORD
WEB_AUTH_2FA=true
WEB_AUTH_MAX_ATTEMPTS=5
WEB_AUTH_LOCKOUT_MINUTES=15
WEB_AUTOLOGIN_ENABLED=true
WEB_AUTOLOGIN_TTL_HOURS=24

# Paths
DB_PATH=data/tasks.db
LOG_FILE=data/telesender.log
LOG_LEVEL=DEBUG
LOG_CONSOLE=false
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
SESSION_PATH=data/session
PLUGINS_DIR=plugins
LANGUAGES_DIR=languages

# Bot
BOT_USERNAME=YOUR_BOT_USERNAME
BOT_TOKEN=YOUR_BOT_TOKEN
# Fallback for BOT_TOKEN
INLINE_BOT_TOKEN=
